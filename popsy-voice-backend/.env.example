# Copia este archivo a ".env" (sin el ".example") y pega ahí tu clave real de OpenAI.
# NUNCA subas el archivo ".env" a git ni lo compartas por chat/correo — es secreto.
OPENAI_API_KEY=sk-...

# Opcional — puerto en el que corre este backend (por defecto 8787).
# Si lo cambias, actualiza también VOICE_BACKEND_URL en marcaciones-popsy.html.
# PORT=8787
